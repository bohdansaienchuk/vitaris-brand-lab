# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Generated output
exports/png/*
exports/pdf/*

# Source assets are tracked only after usage rights are confirmed.
# Current audited originals remain local until that confirmation exists.
/shared/assets/logos/originals/*.png
/shared/assets/logos/originals/*.svg
/brands/evomax-balance/assets/packaging/*.png
/brands/evomax-balance/assets/packaging/*.jpg

# Keep export directories available locally
!exports/png/.gitkeep
!exports/pdf/.gitkeep

# TypeScript and test output
dist/
build/
coverage/
*.tsbuildinfo

# Environment and local configuration
.env
.env.*
!.env.example

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Editors and temporary files
.vscode/
.idea/
*.swp
*.swo
*~
*.tmp
*.temp
.cache/

# Task reports: keep Markdown history, ignore temporary working files
!reports/
!reports/latest.md
!reports/history/
!reports/history/*.md
reports/**/*.tmp
reports/**/*.temp
